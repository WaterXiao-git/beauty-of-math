# AI 路由总开关。配置任一模型密钥后默认启用；设为 false 可强制关闭。
AGENT_AI_ENABLED=true

# DeepSeek 主模型
DEEPSEEK_API_KEY=
DEEPSEEK_BASE_URL=https://api.deepseek.com/v1
DEEPSEEK_MODEL=deepseek-v4-flash
DEEPSEEK_TIMEOUT_MS=8000

# 千问复核与故障接管模型（中国内地北京地域）
QWEN_API_KEY=
QWEN_BASE_URL=https://dashscope.aliyuncs.com/compatible-mode/v1
QWEN_MODEL=qwen3.7-plus
QWEN_TIMEOUT_MS=20000

# 千问语义向量路由。独立密钥留空时复用 QWEN_API_KEY。
# 使用业务空间专属 Key 时，请填写控制台给出的 OpenAI 兼容地址。
QWEN_EMBEDDING_ENABLED=true
QWEN_EMBEDDING_API_KEY=
# 留空时复用 QWEN_BASE_URL；不要填写未替换的占位域名。
QWEN_EMBEDDING_BASE_URL=
QWEN_EMBEDDING_MODEL=qwen3.7-text-embedding-flash
QWEN_EMBEDDING_DIMENSIONS=1024
QWEN_EMBEDDING_TIMEOUT_MS=8000
# 相对于 server/，可填写绝对路径。此目录被 .gitignore 的 .cache/ 排除。
QWEN_EMBEDDING_CACHE_DIR=.cache/embeddings
